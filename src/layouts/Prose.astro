---
// Personal posts (/writings/<slug>/), in the same grid as the rest of the site.
import LongForm from './LongForm.astro';

interface Props {
  title?: string;
  description?: string;
  date?: Date;
  headings?: { depth: number; slug: string; text: string }[];
}

const { title = '', description, date, headings = [] } = Astro.props;
const when = date
  ? date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
  : null;
const notes = [
  ...(when ? [{ label: 'Written', text: when }] : []),
  { label: 'Section', text: 'Personal writing' },
  { label: 'More', text: 'All personal posts →', href: '/work/#personal' },
];
---
<LongForm
  title={title}
  description={description}
  kicker={`Personal writing${when ? ' · ' + when : ''}`}
  heading={title}
  headings={headings}
  notes={notes}
  notesTitle="About this post"
>
  <slot />
</LongForm>
