---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Extra font files to preload on pages that show them above the fold. */
  preload?: string[];
}

const { title, description, preload = [] } = Astro.props;
const pageTitle = title === 'Kashish Kapoor' ? title : `${title} — Kashish Kapoor`;
// Fonts every page paints in its first screen. Preloading them lets the real
// font arrive before first paint on most connections (no visible swap).
const fonts = ['/fonts/fraunces/fraunces-normal-latin.woff2', '/fonts/nunito-sans/nunito-sans-normal-latin.woff2', ...preload];
---
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  {description && <meta name="description" content={description} />}
  <meta property="og:title" content={pageTitle} />
  {description && <meta property="og:description" content={description} />}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title="Kashish Kapoor" href="/rss.xml" />
  {fonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}

  {/* Theme before first paint: saved choice, otherwise light (the default). */}
  <script is:inline>
    (function () {
      var theme = null;
      try { theme = localStorage.getItem('theme'); } catch (e) {}
      document.documentElement.setAttribute('data-theme', theme === 'dark' ? 'dark' : 'light');
    })();
  </script>
</head>
<body>
  <div class="wrap"><Nav /></div>
  <slot name="ticker" />
  <main>
    <slot />
  </main>
  <Footer />
</body>
</html>
